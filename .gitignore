# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.widget_preview/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Browser-test server serves test/, so copy the shipped SQLite assets here.
/test/browser/sqlite3.wasm
/test/browser/drift_worker.js

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The upload key and its passwords. android/key.properties.example is the
# template; the real one names a keystore outside the repository and carries
# the passwords to it, so it is the one genuinely secret file in this project.
/android/key.properties
*.jks
*.keystore

# Generated by build_runner (Drift, Freezed, Riverpod).
# Regenerate with: dart run build_runner build
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart

# Locked CI dependencies and ephemeral Google credentials.
.bundle/
vendor/bundle/
gha-creds-*.json
fastlane/report.xml
fastlane/README.md

# Build-time configuration for real projects. Nothing here is a secret — the
# origin and the Firebase ids are public identifiers — but they are
# per-deployment, and committing one means a fork silently builds against
# somebody else's backend.
env/*.json
!env/*.example.json

# The brand kit exactly as the designer delivered it. Everything the app
# actually uses has been moved into the tree — assets/brand/, assets/icon/,
# assets/splash/, site/favicon.*, site/icons/, and the two
# generator configs at the root — so this is a duplicate copy plus the
# preview HTML its authoring tool wrote. Kept out of the repo rather than
# deleted, so re-running the generators against the originals stays possible.
/brand/

# The generated API client is committed; what resolving it produces is not.
# `pubspec.lock` belongs to applications, not to libraries, and this package is
# only ever consumed by the app above it.
packages/*/.dart_tool/
packages/*/pubspec.lock

# ...except the API client's, which must be committed.
#
# `*.g.dart` above is right for the app: build_runner regenerates freezed,
# drift and riverpod output locally and in CI. It is wrong for a package that
# is consumed as a dependency, because a consumer never runs build_runner on
# one — so a package whose `part 'x.g.dart'` directives point at nothing simply
# does not compile. These are a build artefact that has to travel with its
# sources; `tool/generate_api_client.dart` produces them and CI diffs them.
!packages/opensplit_api/lib/**/*.g.dart
