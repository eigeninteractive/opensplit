# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.widget_preview/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Browser-test server serves test/, so copy the shipped SQLite assets here.
/test/browser/sqlite3.wasm
/test/browser/drift_worker.js

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The upload key and its passwords. android/key.properties.example is the
# template; the real one names a keystore outside the repository and carries
# the passwords to it, so it is the one genuinely secret file in this project.
/android/key.properties
*.jks
*.keystore

# Generated by build_runner (Drift, Freezed, Riverpod).
# Regenerate with: dart run build_runner build
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart

# Locked CI dependencies and ephemeral Google credentials.
.bundle/
vendor/bundle/
gha-creds-*.json
fastlane/report.xml
fastlane/README.md

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
supabase/functions/.env

# Build-time configuration for real projects. Nothing here is a secret — the
# publishable key and the Firebase ids are public identifiers — but they are
# per-deployment, and committing one means a fork silently builds against
# somebody else's backend.
env/*.json
!env/*.example.json

# Firebase Hosting. firebase.json is committed — it is the deploy contract, and
# it is the same for anyone. .firebaserc just names one person's project, so
# each deployer runs `firebase use --add` instead of inheriting a fork's.
.firebaserc
.firebase/

# The brand kit exactly as the designer delivered it. Everything the app
# actually uses has been moved into the tree — assets/brand/, assets/icon/,
# assets/splash/, site/favicon.*, site/icons/, and the two
# generator configs at the root — so this is a duplicate copy plus the
# preview HTML its authoring tool wrote. Kept out of the repo rather than
# deleted, so re-running the generators against the originals stays possible.
/brand/
