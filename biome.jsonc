// Biome's project root, so that it finds server/biome.jsonc from an editor
// opened here. Without a file here Biome takes its built-in defaults as the
// root and refuses the server's config as a second one. Biome formats and
// lints the Worker only; that is all the server's config turns on.
{
  "$schema": "./server/node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "enabled": false },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
