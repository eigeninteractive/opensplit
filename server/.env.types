# Secret NAMES, for type generation only. No values, and never loaded at runtime:
# wrangler auto-loads `.env` and `.dev.vars`, not this file, and it is passed
# explicitly to `wrangler types --env-file`.
#
# It exists because `wrangler types` can only see secrets it is told about, and
# the obvious source — a local `.dev.vars` — is gitignored, so the generated
# types would differ between a developer's machine and CI. This file is
# committed, so they cannot.
#
# Real values are set with `wrangler secret put`. See the runbook.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
EXCHANGERATE_API_KEY=
