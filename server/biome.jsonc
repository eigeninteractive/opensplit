{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  // Nested under the repository's biome.jsonc, which is what lets an editor opened at the
  // repository root find this file at all.
  "root": false,
  "files": {
    "ignoreUnknown": false,
    // The root's `useIgnoreFile` already drops everything `.gitignore` does — `.wrangler`,
    // `node_modules`, `public` — so what is listed here is the opposite case: files that
    // *are* committed and still are not ours to format.
    //
    // `auth-schema.ts` is written by `auth generate` and everything under the three
    // `migrations/` trees by drizzle-kit — including `migrations.js`, which it rewrites
    // on every generate. All are regenerated in CI and diffed, so formatting any of them
    // would turn a regeneration into a drift failure. `worker-configuration.d.ts` is
    // wrangler's. `package.json` is pnpm's — it rewrites it with two-space indent whenever it
    // edits it, which is a fight with no winner.
    "includes": ["**", "!**/worker-configuration.d.ts", "!migrations", "!src/do/*/migrations", "!src/auth-schema.ts", "!package.json", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 320
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
