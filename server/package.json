{
  "name": "opensplit-server",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env test",
    "start": "wrangler dev --env test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p test/tsconfig.json",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply opensplit --local --env test",
    "db:migrate:remote": "wrangler d1 migrations apply opensplit --remote",
    "auth:generate": "auth generate --config src/auth.cli.ts --output src/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:generate:do": "drizzle-kit generate --config drizzle.do.config.ts",
    "db:generate:fx": "drizzle-kit generate --config drizzle.fx.config.ts",
    "openapi": "tsx scripts/write-openapi.ts",
    "check:deploy-config": "tsx scripts/check-deploy-config.ts",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "^1.7.6",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-plugin": "^1.3.3",
    "@types/node": "^26.6.2",
    "auth": "^1.7.6",
    "drizzle-kit": "1.0.0-rc.4",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.144.0"
  }
}
