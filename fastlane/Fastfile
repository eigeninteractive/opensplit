default_platform(:android)

platform :android do
  # Google's *default* closed track is still called "alpha" in the Publishing
  # API, whatever the Play Console calls it on screen. A track created by hand
  # carries whatever name it was given, so this is configurable rather than
  # hardcoded: set PLAY_TRACK to that name and nothing else changes.
  DEFAULT_TRACK = "alpha".freeze

  # Testing lanes cannot publish to production through an environment override.
  TEST_TRACKS = %w[internal alpha beta].freeze

  # How badly a release wants to be installed, on Play's 0-5 scale.
  #
  # This is a property of the release, not of the app, which is why it is set
  # here and not in Dart: the same build is urgent for somebody on a client the
  # server can no longer talk to and ordinary for somebody already current.
  #
  # 0 is the default and means "take it when you like" -- the app downloads it
  # in the background and offers a restart. 4 and 5 are the two Google
  # documents as warranting a blocking flow, and AppUpdateService treats
  # anything from 4 up as immediate.
  #
  # Reach for 4 only when a stale client is actively harmful. For this app that
  # means a sync change the server no longer accepts, where the symptom is an
  # expense that looks saved and silently is not.
  #
  # It can only be set through the Publishing API -- there is no field for it in
  # the Play Console -- and it applies to the release it is uploaded with. It
  # cannot be added to a release after the fact, so a build that needed it and
  # did not get it needs another build.
  DEFAULT_PRIORITY = 0

  desc "Distribute the signed CI bundle to Google Play closed testers"
  lane :closed do
    track = ENV.fetch("PLAY_TRACK", DEFAULT_TRACK)
    unless TEST_TRACKS.include?(track)
      UI.user_error!("PLAY_TRACK must be one of #{TEST_TRACKS.join(', ')}")
    end
    distribute(track: track, status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"))
  end

  desc "Submit the signed CI bundle for full Google Play production release"
  lane :production do
    distribute(track: "production", status: "completed")
  end

  desc "Distribute the signed CI bundle to Google Play internal testers"
  lane :internal do
    distribute(track: "internal", status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"))
  end

  private_lane :distribute do |options|
    priority = Integer(
      ENV.fetch("PLAY_UPDATE_PRIORITY", DEFAULT_PRIORITY), exception: false
    )
    unless priority && (0..5).cover?(priority)
      UI.user_error!("PLAY_UPDATE_PRIORITY must be between 0 and 5")
    end

    track = options.fetch(:track)
    status = options.fetch(:status)
    unless %w[completed draft].include?(status)
      UI.user_error!("PLAY_RELEASE_STATUS must be completed or draft")
    end

    credentials = ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS")
    unless File.file?(credentials)
      UI.user_error!("Google credentials file is missing")
    end

    # Resolve against this file, not Fastlane's changing working directory.
    bundle = File.expand_path(
      "../build/app/outputs/bundle/release/app-release.aab", __dir__
    )
    UI.user_error!("Build the signed release AAB first") unless File.file?(bundle)

    # The complete supply tree: Cider notes plus the committed listing artwork.
    # Prepare it with tool/play_metadata.dart before any production upload.
    metadata = File.expand_path(ENV.fetch("PLAY_METADATA_DIR"))
    required_files = [
      "en-US/changelogs/default.txt",
      "en-US/images/icon.png",
      "en-US/images/featureGraphic.jpg"
    ]
    unless required_files.all? { |path| File.file?(File.join(metadata, path)) } &&
           Dir.glob(File.join(metadata, "en-US/images/phoneScreenshots/*.png")).size == 5
      UI.user_error!("Prepare the complete PLAY_METADATA_DIR with tool/play_metadata.dart")
    end

    if priority >= 4
      UI.important(
        "in-app update priority #{priority}: installed clients can offer " \
        "an immediate update when Play makes it available and allows the flow"
      )
    end
    UI.message("Uploading to the #{track} track with status #{status}")

    upload_to_play_store(
      track: track,
      release_status: status,
      in_app_update_priority: priority,
      json_key: credentials,
      aab: bundle,
      skip_upload_apk: true,
      metadata_path: metadata,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true,
      # Fail visibly rather than silently changing review semantics on retry.
      rescue_changes_not_sent_for_review: false
    )
  end
end
