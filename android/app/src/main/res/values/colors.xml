<?xml version="1.0" encoding="utf-8"?>
<!-- ColorScheme.surface, in the one place Android can read before Dart runs.

     This is the colour of the window from the moment the launcher animation
     ends until Flutter draws its first frame, and on Android 12 and up it is
     also the background of the system splash screen. Anything other than the
     app's own surface shows as a flash on every cold start.

     Kept in step with lib/presentation/theme.dart by a test — see
     test/presentation/theme_test.dart. -->
<resources>
    <color name="surface">#f4fbf8</color>
</resources>
