<?xml version="1.0" encoding="utf-8"?>
<!-- The two colours Android needs before a line of Dart has run.

     `surface` is ColorScheme.surface. It is the window behind the Flutter UI,
     which shows during a rotation or a resize, and the window while the process
     starts on releases older than Android 12. Anything other than the app's own
     surface shows as a flash.

     `ic_launcher_background` is ColorScheme.primaryContainer, and is the flat
     background layer of the adaptive launcher icon. It is written here by
     `dart run flutter_launcher_icons` from the value in
     flutter_launcher_icons.yaml.

     Both are kept in step with lib/presentation/theme.dart by a test — see
     test/presentation/theme_test.dart. -->
<resources>
    <color name="surface">#fcf8ff</color>
    <color name="ic_launcher_background">#E3DFFF</color>
</resources>