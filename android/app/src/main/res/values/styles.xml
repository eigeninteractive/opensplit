<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, before Flutter has a frame to
         show. A plain colour rather than a drawable on purpose: Android 12's
         SplashScreen API adopts windowBackground as its own background when it
         is a single colour, so this one value covers both the old launch
         window and the new system splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!-- The window behind the Flutter UI once it is running. Visible during a
         rotation or a resize, so it is the same surface rather than the
         platform's white. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
